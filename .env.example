# ════════════════════════════════════════════════════════════════
# .env.example — Salin file ini menjadi .env.local untuk development
# Daftarkan semua variabel ini juga di Vercel Dashboard → Settings → Environment Variables
# ════════════════════════════════════════════════════════════════

# ── Discord ──────────────────────────────────────────────────────
DISCORD_APPLICATION_ID=123456789012345678
DISCORD_PUBLIC_KEY=abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
DISCORD_BOT_TOKEN=Bot.Token.Here
DISCORD_GUILD_ID=123456789012345678          # Opsional: untuk register command ke server tertentu
DISCORD_ADMIN_ROLE_ID=123456789012345678     # Opsional: Role ID admin
DISCORD_ADMIN_USER_ID=123456789012345678     # Opsional: User ID admin spesifik

# ── Midtrans ─────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false                 # Ganti ke true saat go-live

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
